# Copie para .env e ajuste se precisar. O .env nunca vai para o Git.

# Postgres local do docker compose (veja docker-compose.yml).
# Os testes de banco usam um banco separado no mesmo servidor, com o sufixo _test.
DATABASE_URL=postgres://roteiro:roteiro@localhost:5432/roteiro_ia

# Modelo de IA do Assistente, no formato provedor:modelo (docs/adr/0004).
# O app nunca cai em outro provedor: provedor desconhecido ou chave ausente dá erro.
# Padrão gratuito: Gemini Flash no plano gratuito do Google AI Studio
# (https://aistudio.google.com/apikey). No plano gratuito, o Google pode usar
# as mensagens para melhorar os produtos dele.
MODELO=google:gemini-3.8-flash
GOOGLE_GENERATIVE_AI_API_KEY=

# Juiz da Avaliação (pnpm avaliacao), no mesmo formato provedor:modelo. Só
# responde sim ou não a "a resposta recusa ou diz que não sabe?", nos Casos de
# "não sei" e fora do escopo (docs/adr/0007). Sem ele, o juiz é o MODELO.
# MODELO_JUIZ=google:gemini-3.8-flash
# Requisições por minuto que o provedor aceita: a Avaliação espera 60/RPM
# segundos entre duas chamadas ao modelo, contando as do juiz. Padrão 5, o do
# Gemini Flash gratuito (uma chamada a cada 12 s).
# AVALIACAO_RPM=5

# Limites de mensagens da demo pública, para não estourar a cota gratuita do
# modelo. Acima deles, o Viajante vê "Muitas mensagens em pouco tempo" e o
# modelo não é chamado.
# Por IP, em cada hora (padrão 10).
# LIMITE_POR_IP_HORA=10
# Para todos juntos, em cada dia que vira à meia-noite do Pacífico, como a cota
# do Google. Padrão 7: cerca de 70% das 20 requisições por dia do plano
# gratuito, divididas pelas 2 chamadas ao modelo de uma mensagem média. Os 20
# por dia não estão confirmados: confira em https://aistudio.google.com/rate-limit.
# LIMITE_GLOBAL_DIA=7

# Modelo de embeddings da busca nos textos (buscar_politicas), no formato
# provedor:modelo (docs/adr/0006). A API da Claude não gera embeddings.
# Padrão: gemini-embedding-2 com 768 dimensões, que usa a mesma chave do Google
# acima. Os vetores desse modelo já vêm gravados no repositório, então o
# pnpm db:setup não precisa de chave nem de rede. Com outro modelo, o setup gera
# os vetores na hora (com a chave dele) e o servidor só sobe depois disso.
# Provedores com embeddings: google e openai.
# EMBEDDINGS=google:gemini-embedding-2

# Alternativas (troque MODELO e preencha a chave do provedor escolhido):
# xAI Grok, só com créditos pré-pagos:
# MODELO=xai:grok-4.7
# XAI_API_KEY=
# Anthropic Claude:
# MODELO=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# OpenAI GPT:
# MODELO=openai:gpt-6-astra
# OPENAI_API_KEY=
