# Copie para .env e ajuste se precisar. O .env nunca vai para o Git.

# Postgres local do docker compose (veja docker-compose.yml).
# Os testes de banco usam um banco separado no mesmo servidor, com o sufixo _test.
DATABASE_URL=postgres://roteiro:roteiro@localhost:5432/roteiro_ia

# Modelo de IA do Assistente, no formato provedor:modelo (docs/adr/0004).
# O app nunca cai em outro provedor: provedor desconhecido ou chave ausente dá erro.
# Padrão gratuito: Gemini Flash no plano gratuito do Google AI Studio
# (https://aistudio.google.com/apikey). No plano gratuito, o Google pode usar
# as mensagens para melhorar os produtos dele.
MODELO=google:gemini-3.8-flash
GOOGLE_GENERATIVE_AI_API_KEY=

# Alternativas (troque MODELO e preencha a chave do provedor escolhido):
# xAI Grok, só com créditos pré-pagos:
# MODELO=xai:grok-4.7
# XAI_API_KEY=
# Anthropic Claude:
# MODELO=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# OpenAI GPT:
# MODELO=openai:gpt-6-astra
# OPENAI_API_KEY=
