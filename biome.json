{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!drizzle/meta",
      "!**/*.md",
      "!!src/catalogo/vetores-gravados.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noShadow": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/app/**",
        "src/db/**",
        "src/*.ts",
        "scripts/**",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/catalogo/*",
                      "**/assistente/*",
                      "!**/assistente/resposta",
                      "!**/assistente/mensagens"
                    ],
                    "message": "Fora do módulo, importe de @/catalogo ou @/assistente (o index.ts). Só resposta.ts e mensagens.ts, que rodam no navegador, são importados direto."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/catalogo/**", "src/assistente/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["next", "next/**", "react", "react/**"],
                    "message": "Os módulos catalogo e assistente são independentes de framework: não importe o Next."
                  },
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "postgres",
                      "**/db/**"
                    ],
                    "message": "O Drizzle e o Postgres ficam só no adaptador em src/db (docs/adr/0001)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
