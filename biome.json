{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!drizzle/meta", "!**/*.md"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["src/catalogo/**", "src/assistente/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["next", "next/**", "react", "react/**"],
                    "message": "Os módulos catalogo e assistente são independentes de framework: não importe o Next."
                  },
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "postgres",
                      "**/db/**"
                    ],
                    "message": "O Drizzle e o Postgres ficam só no adaptador em src/db (docs/adr/0001)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
